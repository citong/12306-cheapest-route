name: Refresh 12306 data

on:
  workflow_dispatch:
    inputs:
      date:
        description: '查询日期 YYYY-MM-DD（留空 = 3 天后）'
        required: false
      from:
        description: '出发地'
        required: false
        default: '新乡'
      to:
        description: '目的地'
        required: false
        default: '昆明'

permissions:
  contents: write

jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Python deps
        run: pip install -r requirements.txt

      - name: Install 12306-mcp
        run: npm install 12306-mcp

      - name: Start 12306-mcp service
        run: |
          node node_modules/12306-mcp/build/index.js --host 127.0.0.1 --port 8080 &
          for i in $(seq 1 20); do
            if curl -s --max-time 3 http://127.0.0.1:8080/sse | head -1 | grep -q endpoint; then
              echo "service ready"; exit 0
            fi
            sleep 1
          done
          echo "service failed to start"; exit 1

      - name: Generate data.json
        env:
          NO_PROXY: localhost,127.0.0.1
          no_proxy: localhost,127.0.0.1
        run: |
          ARGS=()
          [ -n "${{ inputs.date }}" ] && ARGS+=("${{ inputs.date }}")
          ARGS+=(--from "${{ inputs.from }}" --to "${{ inputs.to }}")
          python scripts/export_data.py "${ARGS[@]}"

      - name: Commit and push
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add data.json
          if git diff --staged --quiet; then
            echo "no data change"
          else
            git commit -m "chore: refresh 12306 data ${{ inputs.date || 'auto' }}"
            git push
          fi
